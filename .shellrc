export PATH=/usr/bin/git:$PATH

alias ls="ls -GF"
alias ll="ls -lAGF"
alias la="ls -AGF"
alias cp="cp -i"
alias mv="mv -i"

alias go="git switch"
alias gbdel="git branch -d"
alias gspop="git stash pop"
alias gshow="git show"
alias gsdrop="git stash drop"

alias gom="git switch main"
alias gback="git switch -"
alias gl="git log --graph --decorate --pretty=format:'%C(auto)%h%d %C(reset)%ad (%an) %s' --date=short"
alias gl1="gl -10"

alias gsw="git switch"
alias gpl="git pull"
alias gp="git push"
alias gs="git status -sb"
alias gd="git diff"
alias gds="git diff --stat"
alias gdc="git diff --cached"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"
alias gb="git branch -v"
alias gf="git fetch"
alias gfp="git fetch --prune"
alias gm="git merge"
alias gr="git restore"
alias grs="git restore --staged"
alias gsu="git stash push -u"
alias gsl="git stash list"
alias grh="git reset --hard"
alias gcp="git cherry-pick"

alias dstart="open -a Docker"
alias dps="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dpsa="dps -a"
alias di="docker images"
alias dc="docker compose"
alias dcdev="docker compose -f docker-compose.dev.yml"
alias dcp="docker compose ps"
alias dcs="docker compose stop"
alias dcu="docker compose up"
alias dcud="docker compose up -d"
alias dcdw="docker compose down"
alias dcl="docker compose logs"
alias dclf="docker compose logs -f"
alias dce="docker compose exec"
